{
  "name": "spectral-synth",
  "version": "1.0.0",
  "description": "Making molecular fingerprints audible through sonification of FTIR spectroscopy data",
  "main": "src/app.js",
  "scripts": {
    "dev": "npx serve -l 4174 .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:verbose": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "node scripts/build.js && node scripts/split-library.js",
    "build:fast": "node scripts/build.js",
    "split-library": "node scripts/split-library.js",
    "export-midi": "node scripts/batch-export-midi.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "husky"
  },
  "keywords": [
    "ftir",
    "spectroscopy",
    "sonification",
    "web-audio",
    "chemistry",
    "audio-synthesis"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  },
  "type": "module"
}
